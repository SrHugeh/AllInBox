<Window x:Class="AllInBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="All In Box - Central de Jogos"
        Icon="/Assets/favicon.ico"
        WindowState="Maximized"
        Height="720" Width="1180"
        MinHeight="540" MinWidth="860"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource MainFont}"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">

    <!-- WindowChrome keeps the resize border and stops a maximized window from covering the taskbar -->
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WinChrome" CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- The whole UI (title bar included) is the HTML page in WebView2. The thin frame around it is the resize grip. -->
    <Grid x:Name="RootGrid" Background="{DynamicResource DividerBrush}">
        <wv2:WebView2 x:Name="Web" Margin="5"/>
    </Grid>
</Window>
