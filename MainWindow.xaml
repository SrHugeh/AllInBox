<Window x:Class="AllInBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AllInBox.Models"
        mc:Ignorable="d"
        Title="All In Box - Central de Jogos" 
        Icon="/Assets/favicon.ico"
        WindowState="Maximized"
        Height="720" Width="1180"
        MinHeight="540" MinWidth="860"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFont}"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave">

    <!-- WindowChrome prevents covering Windows Taskbar when Maximized -->
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WinChrome" CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/> <!-- Row 0: Technical Titlebar + Telemetry + Theme + Window Controls -->
            <RowDefinition Height="36"/> <!-- Row 1: Unified Top Navigation Tabs + Platform Filter Strip + Primary Actions -->
            <RowDefinition Height="*"/>  <!-- Row 2: Main Workspace (Library + Side-Dock OR Analytics) -->
            <RowDefinition Height="22"/> <!-- Row 3: Ultra-Compact Status Bar -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TECHNICAL TITLEBAR & LIVE TELEMETRY STRIP (30px)                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MouseDown="Titlebar_MouseDown">
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="/Assets/icon_all_in_box.png" Width="15" Height="15" Margin="0,0,6,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ALL IN BOX" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MANAGER" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Inline Telemetry Metrics (Games, Disk Weight, Playtime) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,1" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="JOGOS:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtTotalGames" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,1" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="DISCO:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtTotalSize" Text="0 MB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="TEMPO:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtTotalPlaytime" Text="0s" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Tagline / Running Game Active Banner -->
                <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="TxtTitlebarStats" Text="Gerenciador compacto de jogos e espaço em disco" 
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Border x:Name="BorderTopRunningBanner" Visibility="Collapsed" Background="{DynamicResource CardSelectedBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="2" Padding="8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTopRunningBanner" Text="EM JOGO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Theme Switcher & Settings -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnQuickTheme" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0"
                            Click="BtnQuickTheme_Click" ToolTip="Alternar Tema (Auto / Escuro / Claro / Personalizado)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTheme}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtQuickThemeLabel" Text="Tema: Auto" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSettings" Style="{StaticResource SecondaryButton}" Padding="7,2"
                            Click="BtnSettings_Click" ToolTip="Configurações, Cores e Bandeja">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Cores / Config" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize to System Tray -->
                    <Button x:Name="BtnHideToTray" Width="32" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                            ToolTip="Ocultar na Bandeja do Sistema (Tray)" Click="BtnHideToTray_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}">
                                    <Path Data="{StaticResource IconTray}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" 
                                          Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize" Width="34" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                            Click="BtnMinimize_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}">
                                    <Path Data="M 0,5 L 9,5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" 
                                          Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button x:Name="BtnMaximize" Width="34" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                            Click="BtnMaximize_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconMax" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" 
                                              Fill="Transparent" Width="9" Height="9"/>
                                        <Path x:Name="IconRestore" Data="M 2,0 L 9,0 L 9,7 M 0,2 L 7,2 L 7,9 L 0,9 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" 
                                              Fill="Transparent" Width="9" Height="9" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose" Width="36" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                            Click="BtnClose_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}">
                                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" 
                                          Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: UNIFIED NAVIGATION TABS, PLATFORM STRIP & COMMAND BAR (36px)       -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Primary View Tabs (Todos, Favoritos, Recentes, Estatísticas/Disco) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderLibrary" Text="BIBLIOTECA" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtHeaderPlatforms" Text="PLATAFORMAS" Visibility="Collapsed"/>

                    <RadioButton x:Name="RadioAll" GroupName="NavGroup" Style="{StaticResource TopFilterTab}" IsChecked="True" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGamepad}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavAll" Text="Todos" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="2" Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCountAll" Text="0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RadioFavorites" GroupName="NavGroup" Style="{StaticResource TopFilterTab}" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconStarFilled}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavFavorites" Text="Favoritos" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="2" Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCountFavorites" Text="0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RadioRecent" GroupName="NavGroup" Style="{StaticResource TopFilterTab}" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClock}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavRecent" Text="Recentes" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="2" Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCountRecent" Text="0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RadioCharts" GroupName="NavGroup" Style="{StaticResource TopFilterTab}" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconChart}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavCharts" Text="Uso de Disco &amp; Dados" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Vertical Divider -->
                <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="8,0" VerticalAlignment="Center"/>

                <!-- Horizontal Platform Filter Chips -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RadioSteam" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/steam_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Steam" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountSteam" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioEpic" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/epic_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Epic" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountEpic" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioRiot" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/riot_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Riot" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountRiot" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioMinecraft" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/minecraft_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Minecraft" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountMinecraft" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioUbisoft" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/ubisoft_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Ubisoft" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountUbisoft" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioGOG" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/gog_icon.png" Width="11" Height="11" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="GOG" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountGOG" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RadioEmulators" GroupName="NavGroup" Style="{StaticResource PlatformChipItem}" Checked="Filter_Changed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGamepad}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Emuladores" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCountEmulators" Text="0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Primary Action Buttons (+ Jogo, Escanear, Limpar/Desduplicar) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="BtnAddGame" Style="{StaticResource PrimaryButton}" Padding="9,4" Margin="0,0,4,0" Click="BtnAddGame_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnAddGame" Text="Adicionar Jogo" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnScanFolder" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnScanFolder_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconScan}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnScan" Text="Escanear" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeduplicate" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnDeduplicate_Click" ToolTip="Des-duplicar jogos, corrigir ícones (.NET/Steam) e calcular tamanho das pastas">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDedupe}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Otimizar Biblioteca" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: MAIN WORKSPACE AREA                                                -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Background="{DynamicResource BgBrush}">

            <!-- 2A. LIBRARY VIEW (Split into Left Main Content + Right Technical Dock) -->
            <Grid x:Name="PanelLibraryView" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Main Game List / Compact Tiles -->
                    <ColumnDefinition Width="250"/>   <!-- Right Quick-Launch & Disk Weight Inspector Dock -->
                </Grid.ColumnDefinitions>

                <!-- LEFT/MAIN COLUMN: Toolbar + Batch Bar + Game Tiles/Table -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>   <!-- Search, Quick-Sort & View Mode Bar -->
                        <RowDefinition Height="Auto"/> <!-- Batch Action Bar -->
                        <RowDefinition Height="*"/>    <!-- Games Container -->
                    </Grid.RowDefinitions>

                    <!-- Sub-Toolbar: Search + 1-Click Sort Pills + Sort Dropdown + View Switcher -->
                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Box -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <TextBox x:Name="TxtSearch" Padding="24,3,8,3" FontSize="12" TextChanged="TxtSearch_TextChanged" Tag="Buscar por título ou plataforma..."/>
                                <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtSearchPlaceholder" Text="Filtrar jogos..." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="25,0,8,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Quick 1-Click Sort Buttons (Including "Mais Pesados no PC") -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="ORDEM RÁPIDA:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnQuickSortSize" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0" Click="BtnQuickSortSize_Click" ToolTip="Listar os jogos que mais pesam no PC primeiro">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mais Pesados (GB)" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnQuickSortRecent" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0" Click="BtnQuickSortRecent_Click" ToolTip="Listar os jogos jogados mais recentemente">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Recentes" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnQuickSortName" Style="{StaticResource SecondaryButton}" Padding="7,2" Click="BtnQuickSortName_Click" ToolTip="Ordenar de A a Z">
                                    <TextBlock Text="A-Z" FontSize="11"/>
                                </Button>
                            </StackPanel>

                            <!-- Full Sort ComboBox & View Mode Switcher -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLabelSort" Text="Ordenar:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="CmbSort" Width="148" SelectedIndex="0" SelectionChanged="CmbSort_SelectionChanged" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Nome (A - Z)"/>
                                    <ComboBoxItem Content="Nome (Z - A)"/>
                                    <ComboBoxItem Content="Jogados Recentemente"/>
                                    <ComboBoxItem Content="Mais Jogados"/>
                                    <ComboBoxItem Content="Tamanho (Maior - Menor)"/>
                                    <ComboBoxItem Content="Tamanho (Menor - Maior)"/>
                                    <ComboBoxItem Content="Adicionados Recentemente"/>
                                    <ComboBoxItem Content="Favoritos Primeiro"/>
                                    <ComboBoxItem Content="Plataforma (A - Z)"/>
                                </ComboBox>

                                <!-- Segmented View Mode Toggle: Horizontal Tiles vs Dense Table -->
                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnViewGrid" Style="{StaticResource SegmentedViewButtonLeft}" Click="BtnViewGrid_Click" ToolTip="Blocos Horizontais Compactos">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconGrid}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtViewCards" Text="Blocos" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="0,2"/>
                                        <Button x:Name="BtnViewList" Style="{StaticResource SegmentedViewButtonRight}" Click="BtnViewList_Click" ToolTip="Tabela Técnica Detalhada">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconList}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtViewList" Text="Tabela" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Batch Action Bar (Visible when items are selected) -->
                    <Border Grid.Row="1" x:Name="PanelBatchBar" Visibility="Collapsed" Background="{DynamicResource CardSelectedBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkBatchAll" Click="ChkBatchAll_Click" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBatchSelectLabel" Text="Selecionar Tudo" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,10,0" VerticalAlignment="Center" Cursor="Hand" MouseDown="TxtBatchSelectLabel_MouseDown"/>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBatchCount" Text="0" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="selecionado(s)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnDeleteSelectedBatch" HorizontalAlignment="Right" Click="BtnDeleteSelectedBatch_Click"
                                    Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0" Padding="8,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconTrash}" Stroke="White" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Remover Selecionados" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- MAIN GAMES CONTAINER -->
                    <Grid Grid.Row="2" Background="{DynamicResource BgBrush}">

                        <!-- VIEW 1: COMPACT HORIZONTAL TECHNICAL TILES (Replaces bulky vertical cards) -->
                        <ScrollViewer x:Name="ScrollGrid" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <ItemsControl x:Name="ItemsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GameItem}">
                                        <Border x:Name="CardBorder" Width="272" Height="60" Margin="3" CornerRadius="2"
                                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Cursor="Hand" MouseLeftButtonDown="GameCard_Click">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="▶ Jogar Agora" Click="MenuPlay_Click" FontWeight="SemiBold"/>
                                                    <MenuItem Header="★ Favoritar / Desfavoritar" Click="MenuToggleFav_Click"/>
                                                    <MenuItem Header="📂 Abrir Pasta do Jogo" Click="MenuOpenFolder_Click"/>
                                                    <MenuItem Header="✏ Editar Informações" Click="MenuEdit_Click"/>
                                                    <Separator Background="{DynamicResource DividerBrush}" Margin="2"/>
                                                    <MenuItem Header="🗑 Remover da Biblioteca" Click="MenuDelete_Click" Foreground="{DynamicResource DangerBrush}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid Margin="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>   <!-- Crisp Icon Box -->
                                                    <ColumnDefinition Width="*"/>    <!-- Title + Platform + Disk Size + Playtime -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Controls (Star, Check, Play/Running) -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Crisp 38x38 Game Icon Frame -->
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="2"
                                                        Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconGamepad}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Visibility="{Binding IconPath, Converter={StaticResource InverseNullToVis}}"/>
                                                        <Image Source="{Binding IconPath, Converter={StaticResource SafeImagePath}}" 
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}"/>
                                                        <!-- Active Running Corner Dot -->
                                                        <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource CardBgBrush}" BorderThickness="1.5"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Jogo em execução"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Col 1: Dense Metadata (Title + Platform/Disk/Time row) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                                    <!-- Row 1: Game Title -->
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>

                                                    <!-- Row 2: Platform Badge + Disk Size + Playtime -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                        <!-- Platform Tag -->
                                                        <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="1" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>

                                                        <!-- Disk Weight -->
                                                        <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>

                                                        <!-- Playtime -->
                                                        <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding PlayTimeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Col 2: Right Action Column (Top: Fav + Batch Check; Bottom: Play / Running Button) -->
                                                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top-Right Mini Controls -->
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource FavoriteStarButton}" Click="BtnCardFav_Click" Padding="2,0" Margin="0,0,2,0"
                                                                Foreground="{Binding IsFavorite, Converter={StaticResource FavStarBrush}}"
                                                                ToolTip="Favorito">
                                                            <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavStarIcon}}" FontSize="11"/>
                                                        </Button>
                                                        <CheckBox x:Name="CardCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="BatchCheckBox_Click"
                                                                  Opacity="0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Bottom-Right Play / Running Pill -->
                                                    <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <Button x:Name="BtnPlayTile" Style="{StaticResource PlayGameButton}" Click="BtnCardPlay_Click" Padding="7,2"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"
                                                                ToolTip="Iniciar Jogo">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentForegroundBrush}" Stretch="Uniform" Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="JOGAR" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2" Padding="6,2"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="● JOGANDO" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="CardCheck" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                <Setter TargetName="CardCheck" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="CardCheck" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- VIEW 2: TECHNICAL DATA TABLE VIEW (With Fixed Interactive Column Headers) -->
                        <Grid x:Name="GridTableView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/> <!-- Fixed Column Headers -->
                                <RowDefinition Height="*"/>  <!-- Scrollable Rows -->
                            </Grid.RowDefinitions>

                            <!-- Table Header Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0,16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>  <!-- Check -->
                                        <ColumnDefinition Width="32"/>  <!-- Icon -->
                                        <ColumnDefinition Width="2.2*"/> <!-- Title -->
                                        <ColumnDefinition Width="110"/> <!-- Platform -->
                                        <ColumnDefinition Width="105"/> <!-- Disk Size -->
                                        <ColumnDefinition Width="105"/> <!-- Playtime -->
                                        <ColumnDefinition Width="110"/> <!-- Last Played -->
                                        <ColumnDefinition Width="28"/>  <!-- Fav -->
                                        <ColumnDefinition Width="86"/>  <!-- Action -->
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Text="JOGO ⇅" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="HeaderTitle_Click" ToolTip="Clique para ordenar por Nome"/>
                                    <TextBlock Grid.Column="3" Text="PLATAFORMA ⇅" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="HeaderPlatform_Click" ToolTip="Clique para ordenar por Plataforma"/>
                                    <TextBlock Grid.Column="4" Text="PESO DISCO ⇅" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="HeaderSize_Click" ToolTip="Clique para ordenar por Tamanho em Disco"/>
                                    <TextBlock Grid.Column="5" Text="TEMPO ⇅" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="HeaderTime_Click" ToolTip="Clique para ordenar por Tempo Jogado"/>
                                    <TextBlock Grid.Column="6" Text="ÚLTIMA SESSÃO ⇅" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="HeaderRecent_Click" ToolTip="Clique para ordenar por Recentes"/>
                                    <TextBlock Grid.Column="8" Text="AÇÃO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ListView Grid.Row="1" x:Name="ListGames" Visibility="Visible" Background="Transparent" BorderThickness="0" 
                                      Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GameItem}">
                                        <Border x:Name="RowBorder" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                                CornerRadius="2" Padding="8,4" Cursor="Hand" MouseLeftButtonDown="GameCard_Click">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="▶ Jogar Agora" Click="MenuPlay_Click" FontWeight="SemiBold"/>
                                                    <MenuItem Header="★ Favoritar / Desfavoritar" Click="MenuToggleFav_Click"/>
                                                    <MenuItem Header="📂 Abrir Pasta do Jogo" Click="MenuOpenFolder_Click"/>
                                                    <MenuItem Header="✏ Editar Informações" Click="MenuEdit_Click"/>
                                                    <Separator Background="{DynamicResource DividerBrush}" Margin="2"/>
                                                    <MenuItem Header="🗑 Remover da Biblioteca" Click="MenuDelete_Click" Foreground="{DynamicResource DangerBrush}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>  <!-- Check -->
                                                    <ColumnDefinition Width="32"/>  <!-- Icon -->
                                                    <ColumnDefinition Width="2.2*"/> <!-- Title -->
                                                    <ColumnDefinition Width="110"/> <!-- Platform -->
                                                    <ColumnDefinition Width="105"/> <!-- Disk Size -->
                                                    <ColumnDefinition Width="105"/> <!-- Playtime -->
                                                    <ColumnDefinition Width="110"/> <!-- Last Played -->
                                                    <ColumnDefinition Width="28"/>  <!-- Fav -->
                                                    <ColumnDefinition Width="86"/>  <!-- Play / Running -->
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="BatchCheckBox_Click" VerticalAlignment="Center"/>

                                                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="2" Background="{DynamicResource InputBgBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Path Data="{StaticResource IconGamepad}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Visibility="{Binding IconPath, Converter={StaticResource InverseNullToVis}}"/>
                                                        <Image Source="{Binding IconPath, Converter={StaticResource SafeImagePath}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="3" Background="{DynamicResource BadgeBgBrush}" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Platform}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                </Border>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding PlayTimeText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="6" Text="{Binding LastPlayedText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <Button Grid.Column="7" Style="{StaticResource FavoriteStarButton}" Click="BtnCardFav_Click"
                                                        Foreground="{Binding IsFavorite, Converter={StaticResource FavStarBrush}}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavStarIcon}}" FontSize="12"/>
                                                </Button>

                                                <Grid Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PlayGameButton}" Click="BtnCardPlay_Click" Padding="9,3"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentForegroundBrush}" Stretch="Uniform" Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="JOGAR" FontSize="10" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2" Padding="6,3"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="● EM JOGO" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- EMPTY STATE -->
                        <StackPanel x:Name="PanelEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <Border x:Name="BorderEmptyIcon" Width="48" Height="48" CornerRadius="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Grid>
                                    <Path x:Name="PathEmptyIcon" Data="{StaticResource IconGamepad}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImgEmptyIcon" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtEmptyTitle" Text="Sua Biblioteca está Vazia" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtEmptySubtitle" Text="Arraste executáveis (.exe) ou atalhos (.lnk) para cá ou escaneie seu PC." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel x:Name="PanelEmptyActions" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Click="BtnScanFolder_Click" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Escanear PC Automaticamente" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Click="BtnAddGame_Click" Padding="12,5">
                                    <TextBlock Text="+ Adicionar Manual" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- RIGHT SIDE-DOCK: QUICK RECENT LAUNCH & HEAVIEST ON DISK INSPECTOR (250px) -->
                <Border Grid.Column="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                        <StackPanel>
                            <!-- DOCK SECTION 1: RECENTLY PLAYED / QUICK LAUNCH -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="JOGADOS RECENTEMENTE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl x:Name="ItemsQuickRecent">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GameItem}">
                                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="2" Background="{DynamicResource CardBgBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Image Source="{Binding IconPath, Converter={StaticResource SafeImagePath}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding LastPlayedText}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource PlayGameButton}" Click="BtnCardPlay_Click" Padding="6,2"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" ToolTip="Iniciar Jogo">
                                                                <TextBlock Text="▶" FontSize="9.5" FontWeight="Bold"/>
                                                            </Button>
                                                            <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2" Padding="4,1"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ON" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- DOCK SECTION 2: HEAVIEST GAMES ON PC (TOP DISK WEIGHT) -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MAIS PESADOS NO PC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="5,1" Click="BtnQuickSortSize_Click" ToolTip="Ordenar lista principal por tamanho">
                                            <TextBlock Text="Listar" FontSize="9.5"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="ItemsQuickHeavy">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:RankedGameStatItem}">
                                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Game.Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,0"
                                                                     Background="{DynamicResource DividerBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 2B. DISK USAGE & STATISTICS ANALYTICS VIEW -->
            <ScrollViewer x:Name="PanelChartsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="12,10" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <StackPanel MaxWidth="1220">
                    <!-- Section Header -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="TxtStatsHeaderTitle" Text="Análise de Espaço em Disco e Tempo de Jogo" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtStatsHeaderSubtitle" Text="Monitore os jogos que mais ocupam armazenamento no PC e suas estatísticas gerais" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Top KPI Strip (6 Compact Technical Cards) -->
                    <UniformGrid Columns="6" Rows="1" Margin="0,0,0,10">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="ESPAÇO EM DISCO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatTotalDiskSize" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,1"/>
                                <TextBlock Text="Peso total calculado" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtKpiPlaytimeTitle" Text="TEMPO TOTAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatTotalPlaytime" Text="0s" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,1"/>
                                <TextBlock x:Name="TxtKpiPlaytimeSub" Text="Horas registradas" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtKpiTotalGamesTitle" Text="TOTAL DE JOGOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatTotalCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,1"/>
                                <TextBlock x:Name="TxtKpiTotalGamesSub" Text="Na biblioteca" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtKpiStartedTitle" Text="JOGOS INICIADOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatPlayedCount" Text="0 (0%)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,1"/>
                                <TextBlock x:Name="TxtKpiStartedSub" Text="Com tempo salvo" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtKpiBacklogTitle" Text="BACKLOG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatNeverPlayedCount" Text="0 (0%)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,1"/>
                                <TextBlock x:Name="TxtKpiBacklogSub" Text="Nunca iniciados" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="TxtKpiFavoritesTitle" Text="FAVORITOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtStatFavoritesCount" Text="0 jogos" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,1"/>
                                <TextBlock x:Name="TxtKpiFavoritesSub" Text="Com estrela" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Two-Column Charts Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Heaviest Games on Disk + Most Played -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Top Heaviest Games on PC -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource IconDisk}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Jogos que Mais Pesam no PC (Tamanho da Pasta)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="ItemsHeaviestGames">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:RankedGameStatItem}">
                                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Width="20" Height="20" CornerRadius="2" Background="{DynamicResource CardBgBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Image Source="{Binding Game.IconPath, Converter={StaticResource SafeImagePath}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                                            <TextBlock Text="{Binding Game.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="4" Margin="0,3,0,0"
                                                                         Background="{DynamicResource DividerBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding ValueFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Most Played Games -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.3" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSectionMostPlayed" Text="Jogos Mais Jogados" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtEmptyMostPlayed" Text="Nenhum jogo iniciado ainda." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="ItemsMostPlayed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:RankedGameStatItem}">
                                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Width="20" Height="20" CornerRadius="2" Background="{DynamicResource CardBgBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Image Source="{Binding Game.IconPath, Converter={StaticResource SafeImagePath}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                                            <TextBlock Text="{Binding Game.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="4" Margin="0,3,0,0"
                                                                         Background="{DynamicResource DividerBrush}" Foreground="{DynamicResource SuccessBrush}" BorderThickness="0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding PlayTimeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Platform Distribution + Summary + Backlog -->
                        <StackPanel Grid.Column="1">
                            <!-- Platform Distribution -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSectionPlatforms" Text="Distribuição por Plataforma" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="ItemsPlatformStats">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PlatformStatItem}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Platform}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="4" Background="{DynamicResource DividerBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Summary Insights -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSectionInsights" Text="Resumo da Biblioteca" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="TxtLabelDominantPlatform" Text="Plataforma Dominante:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtStatTopPlatform" Text="-" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="TxtLabelAvgPlaytime" Text="Média por Jogo Iniciado:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtStatAveragePlaytime" Text="0s" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Never Played Backlog -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSectionNeverPlayed" Text="Backlog (Nunca Jogados)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtEmptyNeverPlayed" Text="Todos os jogos já foram iniciados!" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="ItemsNeverPlayed" MaxHeight="190">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GameItem}">
                                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                                        <Button Grid.Column="2" Style="{StaticResource PlayGameButton}" Click="BtnCardPlay_Click" Padding="6,2">
                                                            <TextBlock Text="▶" FontSize="9"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- DRAG & DROP OVERLAY -->
            <Border x:Name="PanelDragOverlay" Visibility="Collapsed" Background="#D90F1319" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Margin="8" CornerRadius="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Solte Executáveis (.exe), Atalhos (.lnk) ou Pastas Aqui" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ícones e tamanhos de pasta serão extraídos automaticamente" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- LOADING OVERLAY -->
            <Border x:Name="PanelLoadingOverlay" Visibility="Collapsed" Background="#D90F1319">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtLoadingTitle" Text="Processando biblioteca..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadingSubtitle" Text="Extraindo ícones e calculando tamanho..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 3: ULTRA-COMPACT STATUS BAR (22px)                                    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotRunning" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Pronto" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Bandeja do Sistema Ativa (Botão direito no ícone da bandeja mostra jogos recentes)" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
