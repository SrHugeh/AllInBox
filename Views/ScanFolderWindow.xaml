<Window x:Class="AllInBox.Views.ScanFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escanear Pastas de Jogos - All In Box"
        Height="510" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFont}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Compact Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Platform Preset Quick Filters -->
                <RowDefinition Height="Auto"/> <!-- Folder Picker -->
                <RowDefinition Height="*"/>    <!-- Results List -->
                <RowDefinition Height="40"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconScan}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderTitle" Text="Escanear Bibliotecas de Jogos" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="• Detecte executáveis automaticamente" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Width="34" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="clsBrd" Background="Transparent">
                                    <Path x:Name="clsPath" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="clsBrd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter TargetName="clsPath" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Platform Quick Preset Buttons -->
            <StackPanel Grid.Row="1" Margin="12,8,12,6">
                <TextBlock x:Name="TxtDefaultLocations" Text="Locais Padrão por Plataforma:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <WrapPanel x:Name="PanelPresets">
                    <!-- Importar de Todos -->
                    <Button x:Name="BtnPresetAll" Style="{StaticResource PrimaryButton}" Height="25" Margin="0,0,4,4" Padding="9,0" Click="BtnImportAllPlatforms_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Stroke="{DynamicResource AccentForegroundBrush}" Fill="{DynamicResource AccentForegroundBrush}" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtImportAll" Text="Importar de Todos" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Steam -->
                    <Button x:Name="BtnPresetSteam" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="Steam">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/steam_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Steam" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Epic Games -->
                    <Button x:Name="BtnPresetEpic" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="Epic Games">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/epic_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Epic Games" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Riot Games -->
                    <Button x:Name="BtnPresetRiot" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="Riot Games">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/riot_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Riot Games" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Minecraft -->
                    <Button x:Name="BtnPresetMinecraft" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="Minecraft">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/minecraft_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Minecraft" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ubisoft -->
                    <Button x:Name="BtnPresetUbisoft" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="Ubisoft">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/ubisoft_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Ubisoft" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- GOG -->
                    <Button x:Name="BtnPresetGOG" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,4,4" Padding="8,0" Click="BtnPlatformPreset_Click" Tag="GOG">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/gog_icon.png" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="GOG Games" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- Folder Select & Scan Button -->
            <StackPanel x:Name="PanelManualFolder" Grid.Row="2" Margin="12,0,12,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtCustomFolder" Text="Pasta Personalizada para Escanear:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFolderPath" Grid.Column="0" Height="25" Text="C:\Games"/>
                    <Button x:Name="BtnBrowseFolder" Grid.Column="2" Height="25" Content="Procurar Pasta..." Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>
                    <Button x:Name="BtnScan" Grid.Column="4" Height="25" Content="Escanear Pasta" Style="{StaticResource PrimaryButton}" Click="BtnScan_Click"/>
                </Grid>
            </StackPanel>

            <!-- Discovered Games List -->
            <Border Grid.Row="3" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="12,0,12,8">
                <Grid>
                    <!-- Progress Spinner Overlay -->
                    <Grid x:Name="PanelProgress" Visibility="Collapsed" Background="{DynamicResource BgBrush}" Opacity="0.92" Panel.ZIndex="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="160" Height="3" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DividerBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtSearchingProgress" Text="Buscando jogos e executáveis principais..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Empty State -->
                    <StackPanel x:Name="PanelEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                        <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtEmptyTitle" Text="Nenhum jogo escaneado ainda." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtEmptySub" Text="Selecione uma plataforma acima ou clique em 'Importar de Todos'." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,10"/>
                        <Button x:Name="BtnShowManualFolder" Content="Selecionar pasta manualmente..." Style="{StaticResource SecondaryButton}" 
                                Height="25" Padding="10,0" FontSize="11" Click="BtnShowManualFolder_Click" Cursor="Hand"/>
                    </StackPanel>

                    <!-- List of items -->
                    <ListView x:Name="ListDiscovered" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="2,1" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SuggestedTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{DynamicResource BadgeBgBrush}" 
                                                CornerRadius="2" Padding="5,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Platform, Converter={StaticResource PlatformIcon}}" Width="11" Height="11" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Footer Selection & Import -->
            <Border Grid.Row="4" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSelectAll" Content="Selecionar Todos" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                        <Button x:Name="BtnDeselectAll" Content="Desmarcar Todos" Style="{StaticResource SecondaryButton}" Height="25" Click="BtnDeselectAll_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCancel" Content="Cancelar" Style="{StaticResource SecondaryButton}" Height="25" Margin="0,0,6,0" Width="80" Click="BtnClose_Click"/>
                        <Button x:Name="BtnImport" Content="Importar Selecionados (0)" Style="{StaticResource PrimaryButton}" Height="25" Width="170" Click="BtnImport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
