<Window x:Class="AllInBox.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All In Box"
        Width="356" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True"
        Opacity="0"
        FontFamily="{StaticResource MainFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Padding="12,9" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 14px of transparent margin leaves room for the drop shadow -->
    <Border Margin="14" CornerRadius="16" Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSubtleBgBrush}" VerticalAlignment="Center">
                    <Image Source="/Assets/icon_all_in_box.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ALL IN BOX" FontSize="12.5" FontWeight="ExtraBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="DotStatus" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TxtStatus" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TxtSection" Margin="18,6,16,6" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>

            <StackPanel x:Name="RowsPanel" Margin="8,0,8,6"/>

            <TextBlock x:Name="TxtEmpty" Margin="18,2,18,12" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,2"/>

            <!-- Footer -->
            <Grid Margin="12,10,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnOpen" Style="{StaticResource FooterButton}" Click="BtnOpen_Click"/>
                <Button x:Name="BtnExit" Grid.Column="1" Style="{StaticResource FooterButton}" Margin="8,0,0,0" Click="BtnExit_Click"
                        Foreground="{DynamicResource DangerBrush}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
