<Window x:Class="AllInBox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações e Personalização"
        Height="520" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>  <!-- Body -->
                <RowDefinition Height="40"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- 1. COMPACT TITLEBAR -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MouseDown="Titlebar_MouseDown">
                <Grid Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtWinTitle" Text="Configurações &amp; Personalização de Cores" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Width="34" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="clsBorder" Background="Transparent">
                                    <Path x:Name="clsPath" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="clsBorder" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter TargetName="clsPath" Property="Stroke" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. BODY CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,10">
                <StackPanel>

                    <!-- THEME & COLOR CUSTOMIZATION SECTION -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Path Data="{StaticResource IconTheme}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tema e Sistema de Personalização de Cores" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Escolha entre o tema preferido do Windows, Preto-Azul-Cinza, Branco-Papel ou crie sua paleta:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <ComboBox x:Name="CmbTheme" Height="28" SelectionChanged="CmbTheme_SelectionChanged" Margin="0,0,0,8">
                                <ComboBoxItem Content="Automático (Usar Preferido do Sistema Windows)" Tag="auto"/>
                                <ComboBoxItem Content="Escuro Padrão (Preto-Azul-Cinza • Accent Azul Leve)" Tag="dark"/>
                                <ComboBoxItem Content="Claro Padrão (Branco-Papel • Accent Azul-Papel)" Tag="light"/>
                                <ComboBoxItem Content="Personalizado (Definir Cores Manualmente)" Tag="custom"/>
                            </ComboBox>

                            <!-- Quick Theme Preset Swatches -->
                            <TextBlock Text="Predefinições Rápidas de Paleta:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,5,5" Click="BtnPresetDarkSlate_Click" ToolTip="Fundo #0F1319 • Cards #171D26 • Accent #4A8FE7">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" Background="#0F1319" BorderBrush="#4A8FE7" BorderThickness="1.5" CornerRadius="1" Margin="0,0,5,0"/>
                                        <TextBlock Text="Preto-Azul-Cinza" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,5,5" Click="BtnPresetLightPaper_Click" ToolTip="Fundo #F5F3EE • Cards #FAF9F5 • Accent #3A6EA5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" Background="#F5F3EE" BorderBrush="#3A6EA5" BorderThickness="1.5" CornerRadius="1" Margin="0,0,5,0"/>
                                        <TextBlock Text="Branco-Papel" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,5,5" Click="BtnPresetNordic_Click" ToolTip="Cinza-Azulado Nórdico">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" Background="#161B22" BorderBrush="#58A6FF" BorderThickness="1.5" CornerRadius="1" Margin="0,0,5,0"/>
                                        <TextBlock Text="Cinza Grafite" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,0,5" Click="BtnPresetWarmPaper_Click" ToolTip="Papel Creme Quente com Azul Escuro">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" Background="#EFECE4" BorderBrush="#2B5B84" BorderThickness="1.5" CornerRadius="1" Margin="0,0,5,0"/>
                                        <TextBlock Text="Papel Creme" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Custom Hex Color Pickers Panel -->
                            <Border x:Name="PanelCustomColors" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Text="Cores Personalizadas (Código Hex #RRGGBB):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <UniformGrid Columns="2" Rows="2">
                                        <!-- Background Hex -->
                                        <StackPanel Margin="0,0,6,6">
                                            <TextBlock Text="Fundo Principal (Background)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SwatchBg" Grid.Column="0" Width="18" Height="22" CornerRadius="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left"/>
                                                <TextBox x:Name="TxtCustomBg" Grid.Column="1" Height="24" FontSize="11.5" Text="#0F1319" TextChanged="CustomColorInput_TextChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Surface / Cards Hex -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Blocos e Painéis (Superfície)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SwatchSurface" Grid.Column="0" Width="18" Height="22" CornerRadius="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left"/>
                                                <TextBox x:Name="TxtCustomSurface" Grid.Column="1" Height="24" FontSize="11.5" Text="#171D26" TextChanged="CustomColorInput_TextChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Accent Hex -->
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Destaque (Accent Azul)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SwatchAccent" Grid.Column="0" Width="18" Height="22" CornerRadius="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left"/>
                                                <TextBox x:Name="TxtCustomAccent" Grid.Column="1" Height="24" FontSize="11.5" Text="#4A8FE7" TextChanged="CustomColorInput_TextChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Text Hex -->
                                        <StackPanel>
                                            <TextBlock Text="Texto Principal" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SwatchText" Grid.Column="0" Width="18" Height="22" CornerRadius="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left"/>
                                                <TextBox x:Name="TxtCustomText" Grid.Column="1" Height="24" FontSize="11.5" Text="#E6EDF3" TextChanged="CustomColorInput_TextChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM TRAY BEHAVIOR SECTION -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Bandeja do Sistema (System Tray &amp; Jogos Recentes)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="O botão direito no ícone da bandeja mostra seus jogos recentes para iniciar em 1 clique." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkMinimizeOnClose" Content="Manter na bandeja do PC ao clicar no botão Fechar (X)" 
                                      FontSize="11.5" Margin="0,0,0,5" Click="TraySetting_Changed"/>
                            <CheckBox x:Name="ChkMinimizeOnLaunch" Content="Minimizar para a bandeja automaticamente ao iniciar um jogo" 
                                      FontSize="11.5" Click="TraySetting_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- LANGUAGE SECTION -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSectionLang" Text="Idioma / Language" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtLangSubtitle" Text="Selecione o idioma de exibição da interface:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                            <ComboBox x:Name="CmbLanguage" Height="26" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="Automático (Padrão do Sistema)" Tag="auto"/>
                                <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                <ComboBoxItem Content="English (United States)" Tag="en-US"/>
                                <ComboBoxItem Content="Español" Tag="es-ES"/>
                                <ComboBoxItem Content="日本語 (Japanese)" Tag="ja-JP"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. ACTION BUTTONS -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSaveClose" Content="Concluído" Style="{StaticResource PrimaryButton}" Width="90" Height="26" Click="BtnClose_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
