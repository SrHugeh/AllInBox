<Window x:Class="AllInBox.Views.AddEditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar / Editar Jogo - All In Box"
        Height="490" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFont}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Compact Titlebar -->
                <RowDefinition Height="*"/>  <!-- Content Form -->
                <RowDefinition Height="40"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGamepad}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderTitle" Text="Adicionar Novo Jogo" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Width="34" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="clsBrd" Background="Transparent">
                                    <Path x:Name="clsPath" Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="clsBrd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter TargetName="clsPath" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10">
                <StackPanel>
                    
                    <!-- Executable File Selection -->
                    <TextBlock Text="Caminho do Executável (.exe, .bat ou .lnk)*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtExePath" Grid.Column="0" Height="26" TextChanged="TxtExePath_TextChanged"/>
                        <Button Grid.Column="2" Height="26" Content="Procurar..." Style="{StaticResource SecondaryButton}" Click="BtnBrowseExe_Click"/>
                    </Grid>

                    <!-- Title & Icon Preview Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome do Jogo*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTitle" Height="26"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Ícone" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Width="26" Height="26" CornerRadius="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Clique para trocar ícone" MouseLeftButtonDown="BorderIcon_Click">
                                <Grid>
                                    <Image x:Name="ImgIconPreview" Stretch="Uniform" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="TxtNoIcon" Text="+" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Platform & Category Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Plataforma" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbPlatform" Height="26" IsEditable="False">
                                <ComboBoxItem Content="PC / Outros" IsSelected="True"/>
                                <ComboBoxItem Content="Steam"/>
                                <ComboBoxItem Content="Epic Games"/>
                                <ComboBoxItem Content="Riot Games"/>
                                <ComboBoxItem Content="Minecraft"/>
                                <ComboBoxItem Content="Ubisoft"/>
                                <ComboBoxItem Content="GOG"/>
                                <ComboBoxItem Content="EA App"/>
                                <ComboBoxItem Content="Emulador"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Categoria / Gênero" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtCategory" Text="Geral" Height="26"/>
                        </StackPanel>
                    </Grid>

                    <!-- Arguments & Working Directory -->
                    <TextBlock Text="Argumentos de Inicialização (Opcional)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtArguments" Height="26" Margin="0,0,0,8" ToolTip="Ex: -novid -fullscreen"/>

                    <TextBlock Text="Diretório de Trabalho (Opcional)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtWorkDir" Height="26" Margin="0,0,0,8" ToolTip="Deixe em branco para usar o diretório do próprio .exe"/>

                    <!-- Favorite Checkbox -->
                    <CheckBox x:Name="ChkFavorite" Content="Adicionar aos Favoritos" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,2,0,8"/>

                    <!-- Notes -->
                    <TextBlock Text="Anotações / Dicas (Opcional)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                    <TextBox x:Name="TxtNotes" Height="44" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Height="26" Margin="0,0,6,0" Width="85" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave" Content="Salvar" Style="{StaticResource PrimaryButton}" Height="26" Width="110" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
